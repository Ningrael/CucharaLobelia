rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
             get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isAdmin == true ||
             get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isSuperAdmin == true ||
             request.auth.uid == 'xXhjkWRjh0hVBjcYr2qAAFRvGL82'
      );
    }
    
    function isValidPlayerData(data) {
      return data.keys().hasAll(['name', 'email', 'points', 'matchesPlayed', 'wins', 'draws', 'losses', 'vpScored', 'vpConceded', 'leadersKilled', 'leadersLost', 'isAdmin'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.email is string && data.email.matches('.*@.*')
        && data.points is int && data.points >= 0
        && data.matchesPlayed is int && data.matchesPlayed >= 0
        && data.wins is int && data.wins >= 0
        && data.draws is int && data.draws >= 0
        && data.losses is int && data.losses >= 0
        && data.vpScored is int && data.vpScored >= 0
        && data.vpConceded is int && data.vpConceded >= 0
        && data.leadersKilled is int && data.leadersKilled >= 0
        && data.leadersLost is int && data.leadersLost >= 0
        && data.isAdmin is bool
        && (!('isSuperAdmin' in data) || data.isSuperAdmin is bool)
        && (!('status' in data) || data.status is string)
        && (!('banUntil' in data) || data.banUntil is string)
        && (!('banReason' in data) || data.banReason is string)
        && (!('username' in data) || data.username is string)
        && (!('elo' in data) || data.elo is int);
    }

    match /players/{userId} {
      allow read: if true;
      
      allow create: if isAuthenticated() 
        && request.auth.uid == userId
        && isValidPlayerData(request.resource.data)
        && (
          (request.auth.uid == 'xXhjkWRjh0hVBjcYr2qAAFRvGL82'
            && request.resource.data.isAdmin == true 
            && request.resource.data.isSuperAdmin == true)
          ||
          (request.auth.uid != 'xXhjkWRjh0hVBjcYr2qAAFRvGL82'
            && request.resource.data.isAdmin == false 
            && (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false))
        );
      
      allow update: if isAuthenticated();
      allow delete: if (isAdmin() && userId != 'xXhjkWRjh0hVBjcYr2qAAFRvGL82')
        || (isAuthenticated() && request.auth.uid == userId);
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    match /chats/{chatId} {
      allow read, create, update: if isAuthenticated();
    }
    
    match /chats/{chatId}/messages/{messageId} {
      allow read, create, update: if isAuthenticated();
    }
    
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // Bug Reports
    match /bug_reports/{reportId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /visitors/{visitorId} {
      allow read, create: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
